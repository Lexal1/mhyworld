@tool
extends EditorScript

const BLOCKS_DIR := "res://assets/resources/blocks/"
const OUTPUT_PATH := "res://scripts/blocks/Blocks.gd"
const BEGIN_MARKER := "# BEGIN GENERATED BLOCK IDS"
const END_MARKER := "# END GENERATED BLOCK IDS"

func _run() -> void:
	var files: Array = Array(DirAccess.get_files_at(BLOCKS_DIR)).filter(
		func(f: String) -> bool: return f.ends_with(".tres")
	)
	files.sort() # must match the order BlockRegistry loads in

	var regex := RegEx.create_from_string("[^A-Za-z0-9_]")
	var lines: PackedStringArray = []
	var seen_ids := {}
	var seen_names := {}
	var index := 0

	for fname: String in files:
		var block := ResourceLoader.load(BLOCKS_DIR + fname, "", ResourceLoader.CACHE_MODE_REPLACE) as Block
		if block == null:
			push_error("[GenerateBlockIds] Failed to load %s, skipping" % fname)
			continue
		# mirror BlockRegistry.register(): duplicate ids are skipped and don't take an index
		if seen_ids.has(block.id):
			push_error("[GenerateBlockIds] Duplicate id '%s' in %s, skipping" % [block.id, fname])
			continue
		seen_ids[block.id] = true

		var const_name := regex.sub(String(block.id).to_upper(), "_", true)
		if const_name.is_empty() or const_name[0].is_valid_int():
			const_name = "_" + const_name
		if seen_names.has(const_name):
			push_error("[GenerateBlockIds] Constant name clash on %s (%s), skipping" % [const_name, fname])
			continue
		seen_names[const_name] = true

		lines.append("const %s = %d" % [const_name, index])
		index += 1

	var generated := "%s\n# Generated by generate_block_ids.gd, do not edit by hand.\n%s\n%s" % [
		BEGIN_MARKER, "\n".join(lines), END_MARKER
	]

	var text := FileAccess.get_file_as_string(OUTPUT_PATH)
	var begin_idx := text.find(BEGIN_MARKER)
	var end_idx := text.find(END_MARKER)

	if begin_idx != -1 and end_idx > begin_idx:
		text = text.substr(0, begin_idx) + generated + text.substr(end_idx + END_MARKER.length())
	else:
		text = text.rstrip("\n") + "\n\n" + generated + "\n"

	var file := FileAccess.open(OUTPUT_PATH, FileAccess.WRITE)
	if file == null:
		push_error("[GenerateBlockIds] Couldn't open %s: %s" % [OUTPUT_PATH, error_string(FileAccess.get_open_error())])
		return
	file.store_string(text)
	file.close()

	EditorInterface.get_resource_filesystem().update_file(OUTPUT_PATH)
	print("[GenerateBlockIds] Wrote %d block constants to %s" % [lines.size(), OUTPUT_PATH])
